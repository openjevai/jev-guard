# Copy this to `.env` (git-ignored) and paste your key. Used only for the local
# live smoke test (examples/smoke.mjs) — never committed, never needed to build.
JEV_API_KEY=
# Optional: pin a model or switch provider.
# JEV_MODEL=jev-1.13.0
# JEV_PROVIDER=typesafe

# OpenJEV — free community gateway to the same Jev model (https://openjev.sh).
# TypeSafe stays the default; set this (or JEV_PROVIDER=openjev) to use OpenJEV.
# OPENJEV_API_KEY=
